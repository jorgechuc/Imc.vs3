<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Imc.Maui.Views.MainPage"
             Title="Índice de masa corporal">

    <ScrollView>
        <Grid
            RowDefinitions="Auto,Auto,*"
            ColumnDefinitions="*"
            RowSpacing="24"
            Padding="24">
            <Border
                Stroke="LightGray"
                StrokeThickness="2">
                <Grid
                    RowDefinitions="*,*"
                    ColumnDefinitions="Auto,*"
                    Padding="18"
                    RowSpacing="8"
                    ColumnSpacing="8">
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalOptions="Center"
                        Text="Proporcione el peso en kilogramos:"/>
                    <Entry
                        Grid.Row="0"
                        Grid.Column="1"
                        Text="{Binding Path=Peso}"
                        BackgroundColor="WhiteSmoke"/>
                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        VerticalOptions="Center"
                        Text="Proporcione la estatura en metros:"/>
                    <Entry
                        Grid.Row="1"
                        Grid.Column="1"
                        Text="{Binding Path=Estatura}"
                        BackgroundColor="WhiteSmoke"/>
                </Grid>
            </Border>

            <HorizontalStackLayout
                Grid.Row="1"
                Grid.Column="0"
                HorizontalOptions="Center"
                Spacing="24">
                <Button
                    Text="Calcular"
                    BackgroundColor="Green"
                    Command="{Binding Path=CalcularCommand}"/>
                <Button
                    Text="Limpiar"
                    Command="{Binding Path=LimpiarCommand}"/>
            </HorizontalStackLayout>

            <Border
                Grid.Row="2"
                Grid.Column="1"
                Stroke="LightGray"
                StrokeThickness="2">
                <Border.StrokeShape>
                    <RoundRectangle
                        CornerRadius="10"/>
                </Border.StrokeShape>
                <VerticalStackLayout
                    Padding="18"
                    Spacing="8">
                    <Label
                        Text="El índice de masa corporal es:"/>
                    <Label
                        Text="{Binding Path=Imc}"
                        HorizontalOptions="Center"
                        FontSize="Medium"
                        FontAttributes="Bold"/>
                    <Label
                        Text="La situación nutricional de la persona es:"/>
                    <Label
                        Text="{Binding Path=EstadoNutricional}"
                        HorizontalOptions="Center"
                        FontSize="Medium"
                        FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </ScrollView>

</ContentPage>